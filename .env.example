# ==========================================================
# Environment Variables: Agentic AI Data Analysis Assistant
# ==========================================================

# Database Settings
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/agentic_data_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Spring Security & JWT
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Backend & FastAPI Inter-service URLs
FASTAPI_BASE_URL=http://localhost:8000
STORAGE_UPLOAD_DIR=./storage/uploads

# AI / LLM Configuration
# Options: 'local' (offline intelligent heuristic mode - no API key needed), 'openai', 'ollama', 'anthropic'
LLM_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Execution Limits & Security
MAX_FILE_SIZE_MB=50
SANDBOX_TIMEOUT_SECONDS=10
